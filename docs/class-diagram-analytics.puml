@startuml BC-07_Dashboard

note as ImplementationNote
  The Dashboard bounded context is now fully data-driven.
  It is no longer a static view with hardcoded sample data:
  it has its own domain model (AnalyticsReport, StaffMetric),
  a DashboardApi that aggregates six backend endpoints, a
  DashboardAssembler, and a Pinia store (useDashboardStore)
  exposing derived stats and chart series. DashboardView
  keeps only presentation-level SVG geometry helpers.
end note

package "dashboard.domain.model" {
  class AnalyticsReport {
    + reportId: number
    + reportUuid: string
    + generatedBy: string
    + period: string
    + generatedAt: string
    + totalRevenue: number
    + totalTransactions: number
    + conversionRate: number
    + averageDeliveryDays: number
    + onTimeDeliveryRate: number
    + reworkRate: number
    + totalOrders: number
    + pendingBalance0_7: number
    + pendingBalance8_15: number
    + pendingBalance16_30: number
    + pendingBalanceOver30: number
    + constructor(snake_case props)
  }
  class StaffMetric {
    + staffMetricId: number
    + reportId: number
    + employeeName: string
    + quotationsIssued: number
    + salesClosed: number
    + totalRevenue: number
    + constructor(snake_case props)
  }
}

package "dashboard.infrastructure" {
  class DashboardApi {
    - analyticsReports: BaseEndpoint
    - staffMetrics: BaseEndpoint
    - patients: BaseEndpoint
    - workOrders: BaseEndpoint
    - sales: BaseEndpoint
    - products: BaseEndpoint
    + constructor()
    + getAnalyticsReports(): Promise<object[]>
    + getStaffMetrics(): Promise<object[]>
    + getPatients(): Promise<object[]>
    + getWorkOrders(): Promise<object[]>
    + getSales(): Promise<object[]>
    + getProducts(): Promise<object[]>
  }
  class DashboardAssembler {
    + {static} toAnalyticsReport(raw): AnalyticsReport
    + {static} toAnalyticsReportList(raw[]): AnalyticsReport[]
    + {static} toStaffMetric(raw): StaffMetric
    + {static} toStaffMetricList(raw[]): StaffMetric[]
  }
}

package "dashboard.application" {
  class DashboardStore <<Pinia store>> {
    + analyticsReports: Ref<AnalyticsReport[]>
    + staffMetrics: Ref<StaffMetric[]>
    + patients: Ref<object[]>
    + workOrders: Ref<object[]>
    + sales: Ref<Sale[]>
    + products: Ref<object[]>
    + loading: Ref<boolean>
    + error: Ref<string | null>
    + totalPatients: ComputedRef<number>
    + patientsSeenToday: ComputedRef<number>
    + todaysAttendedPatients: ComputedRef<object[]>
    + monthlyRevenue: ComputedRef<number>
    + pendingLabOrders: ComputedRef<number>
    + recetasChartData: ComputedRef<number[]>
    + ventasChartData: ComputedRef<number[]>
    + chartPeriodLabels: ComputedRef<string[]>
    + weekRevenueData: ComputedRef<number[]>
    + recentWorkOrders: ComputedRef<object[]>
    + stockAlerts: ComputedRef<object[]>
    + fetchAll(): Promise<void>
  }
}

package "dashboard.presentation.views" {
  class DashboardView <<view>> {
    - today: ComputedRef<string>
    - stats: ComputedRef<object[]>
    - labOrders: ComputedRef<object[]>
    - stockAlerts: ComputedRef<object[]>
    - recetasData: ComputedRef<number[]>
    - ventasData: ComputedRef<number[]>
    - chartMax: ComputedRef<number>
    - yTicks: ComputedRef<number[]>
    - recPts, venPts: ComputedRef<string>
    - recAreaPts, venAreaPts: ComputedRef<string>
    - gridLines: ComputedRef<object[]>
    - recDots, venDots: ComputedRef<object[]>
    - xLabels: ComputedRef<object[]>
    - weekRevenue: ComputedRef<number[]>
    - barMaxV: ComputedRef<number>
    + parseLocalDate(str): Date
    + labOrderStatusClass(o): string
    + labOrderStatusKey(o): string
    + lx(i, total): number
    + ly(v, max): number
    + bx(i, total): number
    + bw(total): number
  }
}

package "dashboard.presentation" {
  class DashboardRoutes <<configuration>> {
    + path: "/panel"
    + name: "dashboard"
    + component: DashboardView
  }
}

DashboardApi --> BaseEndpoint : uses (x6)
DashboardApi --|> BaseApi

DashboardAssembler --> AnalyticsReport : creates
DashboardAssembler --> StaffMetric : creates

DashboardStore --> DashboardApi : uses
DashboardStore --> DashboardAssembler : uses
DashboardStore ..> SaleAssembler : uses (reuses sales.infrastructure)

DashboardView --> DashboardStore : uses
DashboardView --> DashboardRoutes : registered in
DashboardView ..> Router : uses (useRouter)
DashboardView ..> I18n : uses (useI18n, tm)

note right of DashboardStore
  fetchAll() calls all six DashboardApi endpoints with
  Promise.allSettled: each failed request falls back to an
  empty array (dashboard shows zeros for that slice) instead
  of failing the whole page; error is only set when every
  request rejects.

  Line chart: totalOrders vs totalTransactions across the
  sorted AnalyticsReport periods (last N months).
  Bar chart: totalRevenue per AnalyticsReport period.
  stockAlerts: products with stock <= 2x their
  minimumStockThreshold.
end note

note right of DashboardView
  Chart geometry (lx/ly/bx/bw + SVG point-string builders)
  stays local to the view; only the underlying numeric
  series come from DashboardStore.
end note

@enduml
