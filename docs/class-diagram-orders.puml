@startuml BC-04_OrderFulfillment

package "fulfillment.domain.model" {
  class WorkOrder {
    + id: string
    + saleId: number
    + recipeId: number
    + labId: number
    + status: string
    + deliveryDate: string
    + patientName: string
    + laboratoryName: string
    + lensType: string
    + frame: string
    + prescription: string
    + priority: string
    + deposit: number
    + total: number
    + isRework: boolean
    + constructor()
  }
  class Laboratory {
    + id: number
    + name: string
    + contactInfo: string
    + constructor()
  }
  class OrderStatus <<object>> {
    + PENDING: string
    + IN_PRODUCTION: string
    + QUALITY_CONTROL: string
    + READY: string
    + DELIVERED: string
  }
  class OrderPriority <<object>> {
    + URGENT: string
    + HIGH: string
    + NORMAL: string
  }
}

package "fulfillment.infrastructure" {
  class WorkOrderResource {
    + order_id: string
    + sale_id: number
    + recipe_id: number
    + lab_id: number
    + status: string
    + delivery_date: string
    + patient_name: string
    + laboratory_name: string
    + lens_type: string
    + frame: string
    + prescription: string
    + priority: string
    + deposit: number
    + total: number
    + is_rework: boolean
  }
  class LaboratoryResource {
    + lab_id: number
    + name: string
    + contact_info: string
  }
  class WorkOrderAssembler {
    + {static} toEntityFromResource(r: WorkOrderResource): WorkOrder
    + {static} toEntitiesFromResponse(r: WorkOrderResource[]): WorkOrder[]
    + {static} toResourceFromEntity(wo: WorkOrder): WorkOrderResource
  }
  class LaboratoryAssembler {
    + {static} toEntityFromResource(r: LaboratoryResource): Laboratory
    + {static} toEntitiesFromResponse(r: LaboratoryResource[]): Laboratory[]
  }
  class WorkOrderApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getWorkOrders(): Promise<WorkOrderResource[]>
    + createWorkOrder(r: WorkOrderResource): Promise<WorkOrderResource>
    + updateOrderStatus(id: string, status: string): Promise<WorkOrderResource>
  }
  class LaboratoryApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getLaboratories(): Promise<LaboratoryResource[]>
  }
}

package "fulfillment.application" {
  class FulfillmentStore {
    + workOrders: ComputedRef<WorkOrder[]>
    + laboratories: ComputedRef<Laboratory[]>
    + pendingOrders: ComputedRef<WorkOrder[]>
    + loadWorkOrders(): Promise<void>
    + loadLaboratories(): Promise<void>
    + createWorkOrder(wo: WorkOrder): Promise<void>
    + updateOrderStatus(id: string, status: string): Promise<void>
  }
}

package "fulfillment.presentation.views" {
  class LabOrderListView <<view>> {
    - currentView: Ref<string>
    - searchQuery: Ref<string>
    - statusFilter: Ref<string>
    - selectedOrder: Ref<WorkOrder | null>
    - showNewOrderModal: Ref<boolean>
    - filteredOrders: ComputedRef<WorkOrder[]>
    - summary: ComputedRef<object[]>
  }
}

package "fulfillment.presentation.components" {
  class KanbanBoard <<component>> {
    + workOrders: WorkOrder[] (prop)
    + emit status-changed: (id: string, status: string)
  }
  class WorkOrderList <<component>> {
    + workOrders: WorkOrder[] (prop)
    + emit order-selected: (wo: WorkOrder)
  }
  class WorkOrderItem <<component>> {
    + workOrder: WorkOrder (prop)
    + emit status-changed: (id: string, status: string)
  }
  class WorkOrderDetailModal <<component>> {
    + order: WorkOrder (prop)
    + emit close: void
    + emit status-changed: (id: string, status: string)
  }
  class NewWorkOrderModal <<component>> {
    + emit saved: (wo: WorkOrder)
    + emit close: void
  }
}

BaseApi <|-- WorkOrderApi
BaseApi <|-- LaboratoryApi
WorkOrderApi --> BaseEndpoint : uses
LaboratoryApi --> BaseEndpoint : uses

WorkOrderAssembler ..> WorkOrderResource : transforms
WorkOrderAssembler --> WorkOrder : creates
LaboratoryAssembler ..> LaboratoryResource : transforms
LaboratoryAssembler --> Laboratory : creates

FulfillmentStore --> WorkOrderApi : uses
FulfillmentStore --> LaboratoryApi : uses
FulfillmentStore --> WorkOrderAssembler : uses
FulfillmentStore --> LaboratoryAssembler : uses

LabOrderListView --> FulfillmentStore : uses
LabOrderListView *-- KanbanBoard : contains
LabOrderListView *-- WorkOrderList : contains
LabOrderListView *-- WorkOrderDetailModal : contains
LabOrderListView *-- NewWorkOrderModal : contains
WorkOrderList *-- WorkOrderItem : composes

WorkOrder ..> OrderStatus : uses
WorkOrder ..> OrderPriority : uses

note right of OrderStatus
  Defined as Object.freeze({...}) in JS.
end note

note right of WorkOrderApi
  updateOrderStatus uses PATCH
  to send only { status } field.
end note

@enduml
