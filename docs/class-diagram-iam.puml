@startuml BC-01_IAM

note as PlanningNote
  ⚠ This bounded context is PLANNED / NOT IMPLEMENTED.
  No src/iam/ directory exists in the codebase.
  The classes below represent the intended design.
  Authentication is currently bypassed (hardcoded user in Layout).
end note

package "iam.domain.model" {
  class User {
    + id: number
    + username: string
    + passwordHash: string
    + role: string
    + constructor()
  }
  class UserRole <<object>> {
    + ADMIN: string
    + EMPLOYEE: string
    + OPTOMETRIST: string
  }
}

package "iam.infrastructure" {
  class UserResource {
    + user_id: number
    + username: string
    + password_hash: string
    + role_id: number
  }
  class RoleResource {
    + role_id: number
    + name: string
  }
  class AuthResponse {
    + token: string
    + user: UserResource
  }
  class UserAssembler {
    + {static} toEntityFromResource(r: UserResource): User
  }
  class AuthApi {
    - endpoint: BaseEndpoint
    + constructor()
    + login(username: string, password: string): Promise<AuthResponse>
    + register(username: string, password: string, roleId: number): Promise<AuthResponse>
  }
}

package "iam.application" {
  class AuthStore {
    + currentUser: ComputedRef<User | null>
    + token: ComputedRef<string | null>
    + isAuthenticated: ComputedRef<boolean>
    + isAdmin: ComputedRef<boolean>
    + login(username: string, password: string): Promise<void>
    + logout(): void
    + register(username: string, password: string, roleId: number): Promise<void>
  }
}

package "iam.presentation.components" {
  class LoginForm <<component>> {
    - username: Ref<string>
    - password: Ref<string>
    + emit submitted: (credentials: object)
  }
  class RegisterForm <<component>> {
    - username: Ref<string>
    - password: Ref<string>
    - roleId: Ref<number>
    + emit submitted: (data: object)
  }
}

BaseApi <|-- AuthApi
AuthApi --> BaseEndpoint : uses
AuthApi ..> AuthResponse : returns
AuthResponse *-- UserResource : contains
AuthStore --> AuthApi : uses
AuthStore --> UserAssembler : uses
UserAssembler ..> UserResource : transforms
UserAssembler --> User : creates
User ..> UserRole : uses
RoleResource --* UserResource

@enduml
