        UnexpectedError
    }

    enum RegisterProductError <<enum>> {
        DuplicateSku
        UnexpectedError
    }

    enum RestockProductError <<enum>> {
        ProductNotFound
        InvalidQuantity
        UnexpectedError
    }

    enum UpdateProductError <<enum>> {
        ProductNotFound
        UnexpectedError
    }

    enum UpdateStockLevelError <<enum>> {
        ProductNotFound
        UnexpectedError
    }

