        InvalidContact
        UnexpectedError
    }

    enum LogManualAdjustmentError <<enum>> {
        ProductNotFound
        JustificationRequired
        UnexpectedError
    }

    enum ReduceStockError <<enum>> {
        ProductNotFound
        InvalidQuantity
