        DuplicateName
        InvalidContact
        UnexpectedError
    }

    enum "LogManualAdjustmentError" as LogManualAdjustmentError <<enum>> {
        ProductNotFound
        JustificationRequired
        UnexpectedError
    }

    enum "ReduceStockError" as ReduceStockError <<enum>> {
        ProductNotFound
        InvalidQuantity
        InsufficientStock
        UnexpectedError
    }

    enum "RegisterProductError" as RegisterProductError <<enum>> {
        DuplicateSku
        UnexpectedError
    }

    enum "RestockProductError" as RestockProductError <<enum>> {
        ProductNotFound
