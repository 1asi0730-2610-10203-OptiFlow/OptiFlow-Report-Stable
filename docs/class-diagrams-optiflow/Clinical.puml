package "optiflow_platform.Clinical.Interfaces.REST" {
    class ClinicalRecordsController  {
        + GetAllClinicalRecords(default): Task<ActionResult>
        + GetClinicalRecordById(id, default): Task<ActionResult>
        + GetClinicalRecordByPatientId(patientId, default): Task<ActionResult>
    }

    class PrescriptionsController  {
        + GetAllPrescriptions(default): Task<ActionResult>
        + GetPrescriptionsByRecord(recordId, default): Task<ActionResult>
    }

    class PatientsController  {
