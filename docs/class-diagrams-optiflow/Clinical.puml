package "optiflow_platform.Clinical.Application.Errors" {
    enum "CreatePatientError" as CreatePatientError <<enum>> {
        DniAlreadyExists
        UnexpectedError
    }

    enum "UpdatePatientError" as UpdatePatientError <<enum>> {
        PatientNotFound
        DniAlreadyExists
        UnexpectedError
    }

    enum "CreatePrescriptionError" as CreatePrescriptionError <<enum>> {
        ClinicalRecordNotFound
        UnexpectedError
    }

}

package "optiflow_platform.Clinical.Application.Services" {
    interface "IClinicalRecordQueryService" as IClinicalRecordQueryService <<interface>> {
        - Handle(GetAllClinicalRecordsQuery query, CancellationToken cancellationToken): Task<IEnumerable<ClinicalRecord>>
        - Handle(GetClinicalRecordByIdQuery query, CancellationToken cancellationToken): Task<ClinicalRecord?>
        - Handle(GetClinicalRecordByPatientIdQuery query, CancellationToken cancellationToken): Task<ClinicalRecord?>
    }

    interface "IPrescriptionCommandService" as IPrescriptionCommandService <<interface>> {
        - Handle(CreatePrescriptionCommand command, CancellationToken cancellationToken): Task<Result<Prescription, CreatePrescriptionError>>
    }

    interface "IPrescriptionQueryService" as IPrescriptionQueryService <<interface>> {
        - Handle(GetAllPrescriptionsQuery query, CancellationToken cancellationToken): Task<IEnumerable<Prescription>>
        - Handle(GetPrescriptionsByRecordIdQuery query, CancellationToken cancellationToken): Task<IEnumerable<Prescription>>
    }

    interface "IPatientCommandService" as IPatientCommandService <<interface>> {
        - Handle(CreatePatientCommand command, CancellationToken cancellationToken): Task<Result<Patient, CreatePatientError>>
        - Handle(UpdatePatientCommand command, CancellationToken cancellationToken): Task<Result<Patient, UpdatePatientError>>
    }

    interface "IPatientQueryService" as IPatientQueryService <<interface>> {
        - Handle(GetAllPatientsQuery query, CancellationToken cancellationToken): Task<IEnumerable<Patient>>
