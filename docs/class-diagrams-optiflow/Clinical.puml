        - Handle(GetPatientByDniQuery query, CancellationToken cancellationToken): Task<Patient?>
        - Handle(GetPatientByEmailQuery query, CancellationToken cancellationToken): Task<Patient?>
    }

}

package "optiflow_platform.Clinical.Domain.Repositories" {
