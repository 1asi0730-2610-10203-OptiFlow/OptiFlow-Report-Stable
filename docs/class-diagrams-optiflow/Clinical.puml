package "optiflow_platform.Clinical.Interfaces.REST.Transform" {
    class CreatePatientCommandFromResourceAssembler  {
        + ToCommandFromResource(resource): CreatePatientCommand
    }

    class UpdatePatientCommandFromResourceAssembler  {
        + ToCommandFromResource(patientId, resource): UpdatePatientCommand
    }

    class PatientResourceFromEntityAssembler  {
        + ToResourceFromEntity(entity): PatientResource
    }

    class ClinicalRecordResourceFromEntityAssembler  {
        + ToResourceFromEntity(entity): ClinicalRecordResource
    }

    class CreatePrescriptionCommandFromResourceAssembler  {
        + ToCommandFromResource(resource): CreatePrescriptionCommand
