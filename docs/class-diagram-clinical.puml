@startuml BC-02_Clinical

package "clinical.domain.model" {
  class Patient {
    + id: number
    + customerUuid: string
    + firstName: string
    + lastName: string
    + dni: string
    + phone: string
    + email: string
    + birthDate: string
    + constructor()
    + get fullName(): string
    + get initials(): string
    + get age(): number | null
  }
  class ClinicalRecord {
    + id: number
    + clinicalRecordUuid: string
    + patientId: number
    + constructor()
  }
  class Prescription {
    + id: number
    + prescriptionUuid: string
    + clinicalRecordId: number
    + odSphere: number
    + odCylinder: number
    + odAxis: number
    + oiSphere: number
    + oiCylinder: number
    + oiAxis: number
    + addition: number | null
    + notes: string
    + createdAt: string
    + doctorName: string
    + constructor()
    + get formattedDate(): string
    + formatValue(val): string
  }
}

package "clinical.infrastructure" {
  class PatientResource {
    + patient_id: number
    + customer_uuid: string
    + first_name: string
    + last_name: string
    + dni: string
    + phone: string
    + email: string
    + birth_date: string
  }
  class ClinicalRecordResource {
    + id: number
    + clinical_record_uuid: string
    + patient_id: number
  }
  class PrescriptionResource {
    + prescription_id: number
    + prescription_uuid: string
    + clinical_record_id: number
    + od_sphere: number
    + od_cylinder: number
    + od_axis: number
    + oi_sphere: number
    + oi_cylinder: number
    + oi_axis: number
    + addition: number | null
    + notes: string
    + created_at: string
    + doctor_name: string
  }
  class PatientAssembler {
    + {static} toEntityFromResource(r: PatientResource): Patient
    + {static} toEntitiesFromResponse(r: PatientResource[]): Patient[]
    + {static} toResourceFromEntity(p: Patient): PatientResource
  }
  class PrescriptionAssembler {
    + {static} toEntityFromResource(r: PrescriptionResource): Prescription
    + {static} toEntitiesFromResponse(r: PrescriptionResource[]): Prescription[]
    + {static} toResourceFromEntity(p: Prescription): PrescriptionResource
  }
  class PatientApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getPatients(): Promise<PatientResource[]>
    + getPatientById(id: number): Promise<PatientResource>
    + createPatient(r: PatientResource): Promise<PatientResource>
    + updatePatient(r: PatientResource): Promise<PatientResource>
    + deletePatient(id: number): Promise<void>
  }
  class ClinicalRecordApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getClinicalRecords(): Promise<ClinicalRecordResource[]>
    + getByPatientId(patientId: number): Promise<ClinicalRecordResource[]>
    + createClinicalRecord(r: object): Promise<ClinicalRecordResource>
  }
  class PrescriptionApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getPrescriptions(): Promise<PrescriptionResource[]>
    + getPrescriptionsByRecordId(recordId: number): Promise<PrescriptionResource[]>
    + createPrescription(r: PrescriptionResource): Promise<PrescriptionResource>
  }
}

package "clinical.application" {
  class ClinicalStore {
    + patients: ComputedRef<Patient[]>
    + prescriptions: ComputedRef<Prescription[]>
    + clinicalRecords: ComputedRef<object[]>
    + loading: Ref<boolean>
    + errors: Ref<string[]>
    + loadPatients(): Promise<void>
    + createPatient(data: Patient): Promise<Patient>
    + loadClinicalRecords(): Promise<void>
    + getRecordForPatient(patientId: number): object | null
    + loadPrescriptions(): Promise<void>
    + loadPrescriptionsByRecord(recordId: number): Promise<Prescription[]>
    + createPrescription(data: Prescription): Promise<Prescription>
    + getPrescriptionsForRecord(recordId: number): Prescription[]
  }
}

package "clinical.presentation.views" {
  class PatientListView <<view>> {
    - searchQuery: Ref<string>
    - showAddPatient: Ref<boolean>
    - showSuccess: Ref<boolean>
    - successMsg: Ref<string>
    - selectedPatient: Ref<Patient | null>
    - currentPage: Ref<number>
    - filteredPatients: ComputedRef<Patient[]>
    - pagedPatients: ComputedRef<Patient[]>
    - stats: ComputedRef<object[]>
    + onAddPatient(data: Patient): Promise<void>
    + onSuccessNext(): void
    + openHce(patient: Patient): void
    + latestPrescriptionFor(patient: Patient): Prescription | null
    + formatVal(val): string
  }
}

package "clinical.presentation.components" {
  class ModalAddPatient <<component>> {
    + emit save: (data: object)
    + emit close: void
  }
  class ModalHce <<component>> {
    + patient: Patient (prop)
    + emit close: void
  }
  class ModalSuccess <<component>> {
    + message: string (prop)
    + emit next: void
  }
  class ModalNewExam <<component>> {
    + emit save: void
    + emit close: void
  }
}

BaseApi <|-- PatientApi
BaseApi <|-- ClinicalRecordApi
BaseApi <|-- PrescriptionApi
PatientApi --> BaseEndpoint : uses
ClinicalRecordApi --> BaseEndpoint : uses
PrescriptionApi --> BaseEndpoint : uses

PatientAssembler ..> PatientResource : transforms
PatientAssembler --> Patient : creates
PrescriptionAssembler ..> PrescriptionResource : transforms
PrescriptionAssembler --> Prescription : creates

ClinicalStore --> PatientApi : uses
ClinicalStore --> ClinicalRecordApi : uses
ClinicalStore --> PrescriptionApi : uses
ClinicalStore --> PatientAssembler : uses
ClinicalStore --> PrescriptionAssembler : uses

PatientListView --> ClinicalStore : uses
PatientListView *-- ModalAddPatient : contains
PatientListView *-- ModalHce : contains
PatientListView *-- ModalSuccess : contains

note right of ClinicalRecord
  ClinicalRecord entity exists in domain model.
  The store saves raw API response objects
  (not assembled via entity) in clinicalRecords.
  getRecordForPatient matches on r.patient_id.
end note

note right of ClinicalStore
  createPatient also auto-creates a linked
  ClinicalRecord via ClinicalRecordApi.
end note

@enduml
