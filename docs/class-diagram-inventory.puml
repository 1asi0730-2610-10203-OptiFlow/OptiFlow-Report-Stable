@startuml BC-05_Inventory

package "inventory.domain.model" {
  class Product {
    + id: number
    + supplierId: number
    + brand: string
    + model: string
    + price: number
    + stock: number
    + name: string
    + category: string
    + sku: string
    + minimumStockThreshold: number
    + supplierName: string
    + lastRestockDate: string
    + constructor(props)
  }
  class Supplier {
    + id: number
    + name: string
    + contactPerson: string
    + phone: string
    + email: string
    + constructor(props)
  }
  class PRODUCT_CATEGORIES <<const array>> {
    + value: string
    + labelKey: string
  }
}

package "inventory.domain.events" {
  class InventoryEvents <<object>> {
    + PRODUCT_CREATED: string
    + PRODUCT_UPDATED: string
    + PRODUCT_DELETED: string
    + STOCK_RESTOCKED: string
    + STOCK_LOW_ALERT: string
  }
}

package "inventory.infrastructure" {
  class ProductResource {
    + product_id: number
    + supplier_id: number
    + brand: string
    + model: string
    + price: number
    + stock: number
    + name: string
    + category: string
    + sku: string
    + minimum_stock_threshold: number
    + supplier_name: string
    + last_restock_date: string
  }
  class SupplierResource {
    + name: string
    + contactPerson: string
    + phone: string
    + email: string
  }
  class ProductAssembler {
    + {static} toEntityFromResource(r: ProductResource): Product
    + {static} toEntitiesFromResponse(r: ProductResource[]): Product[]
    + {static} toResourceFromEntity(p: Product): ProductResource
  }
  class SupplierAssembler {
    + {static} toEntityFromResource(r: SupplierResource): Supplier
    + {static} toEntitiesFromResponse(r: SupplierResource[]): Supplier[]
    + {static} toResourceFromEntity(s: Supplier): SupplierResource
  }
  class ProductApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getProducts(): Promise<ProductResource[]>
    + createProduct(r: ProductResource): Promise<ProductResource>
    + updateProduct(id: number, payload: object): Promise<ProductResource>
    + deleteProduct(id: number): Promise<void>
    + restockProduct(id: number, quantity: number, author: string): Promise<ProductResource>
  }
  class SupplierApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getSuppliers(): Promise<SupplierResource[]>
    + createSupplier(r: SupplierResource): Promise<SupplierResource>
  }
  class StockAuditLogApi {
    - resourcePath: string
    + constructor()
    + getAuditLogs({from, to}): Promise<object[]>
  }
}

package "inventory.application" {
  class InventoryStore <<Pinia store>> {
    + products: ComputedRef<Product[]>
    + suppliers: ComputedRef<Supplier[]>
    + lowStockProducts: ComputedRef<Product[]>
    + loading: Ref<boolean>
    + errors: Ref<string[]>
    + loadProducts(): Promise<void>
    + loadSuppliers(): Promise<void>
    + createProduct(p: Product): Promise<void>
    + updateProduct(p: Product): Promise<void>
    + deleteProduct(id: number): Promise<void>
    + createProductFromResource(r: object): Promise<void>
    + restock(id: number, qty: number, operation: string): Promise<void>
  }
}

package "inventory.presentation.views" {
  class InventoryListView <<view>> {
    - searchQuery: Ref<string>
    - categoryFilter: Ref<string>
    - stockLevelFilter: Ref<string>
    - showAddProduct: Ref<boolean>
    - selectedProductRestock: Ref<Product | null>
    - showBulkRestock: Ref<boolean>
    - showAuditLog: Ref<boolean>
    - summary: ComputedRef<object[]>
    + getStockStatus(stock, threshold): object
  }
}

package "inventory.presentation.components" {
  class ModalAddProduct <<component>> {
    + suppliers: Supplier[] (prop)
    + emit save: (product: Product)
    + emit close: void
  }
  class ModalEditProduct <<component>> {
    + product: Product (prop)
    + emit save: (product: Product)
    + emit close: void
  }
  class ModalRestock <<component>> {
    + product: Product (prop)
    + emit save: (product: Product)
    + emit close: void
  }
  class ModalBulkRestock <<component>> {
    + products: Product[] (prop)
    + emit save: void
    + emit close: void
  }
  class ModalAuditLog <<component>> {
    - logs: Ref<object[]>
    + emit close: void
  }
  class RegisterSupplierModal <<component>> {
    + emit save: (supplier: Supplier)
    + emit close: void
  }
}

BaseApi <|-- ProductApi
BaseApi <|-- SupplierApi
BaseApi <|-- StockAuditLogApi
ProductApi --> BaseEndpoint : uses
SupplierApi --> BaseEndpoint : uses

ProductAssembler ..> ProductResource : transforms
ProductAssembler --> Product : creates
SupplierAssembler ..> SupplierResource : transforms
SupplierAssembler --> Supplier : creates

InventoryStore --> ProductApi : uses
InventoryStore --> SupplierApi : uses
InventoryStore --> ProductAssembler : uses
InventoryStore --> SupplierAssembler : uses
InventoryStore ..> InventoryEvents : emits (via eventBus)

InventoryListView --> InventoryStore : uses
InventoryListView *-- ModalAddProduct : contains
InventoryListView *-- ModalEditProduct : contains
InventoryListView *-- ModalRestock : contains
InventoryListView *-- ModalBulkRestock : contains
InventoryListView *-- ModalAuditLog : contains
InventoryListView *-- RegisterSupplierModal : contains
ModalAuditLog --> StockAuditLogApi : uses directly (bypasses store)

Product ..> PRODUCT_CATEGORIES : uses

note right of PRODUCT_CATEGORIES
  There is no more Category entity, CategoryResource,
  CategoryAssembler, or CategoryApi. Categories are now a
  static, hard-coded array of {value, labelKey} pairs used
  directly by the UI; Product.category is a plain string.
end note

note right of InventoryStore
  lowStockProducts filters products where stock <= 3
  (hard-coded threshold).

  Mutating actions (createProduct/Product/FromResource,
  updateProduct, deleteProduct, restock) emit events on the
  shared eventBus (InventoryEvents) so other parts of the
  app (e.g. the dashboard's stock alerts) can react without
  a direct dependency on this store.
end note

note right of ProductApi
  updateProduct uses PUT with the product id as the URL
  path segment. restockProduct POSTs to .../{id}/restock.
end note

note right of SupplierResource
  Unlike ProductResource, SupplierResource fields are
  camelCase (no id field — only used for create payloads).
end note

@enduml
