@startuml BC-05_Inventory

package "inventory.domain.model" {
  class Product {
    + id: number
    + categoryId: number
    + supplierId: number
    + brand: string
    + model: string
    + price: number
    + stock: number
    + name: string
    + category: string
    + sku: string
    + minimumStockThreshold: number
    + supplierName: string
    + lastRestockDate: string
    + constructor()
  }
  class Category {
    + id: number
    + name: string
    + constructor()
  }
  class Supplier {
    + id: number
    + name: string
    + contactPerson: string
    + phone: string
    + email: string
    + constructor()
  }
}

package "inventory.infrastructure" {
  class ProductResource {
    + product_id: number
    + category_id: number
    + supplier_id: number
    + brand: string
    + model: string
    + price: number
    + stock: number
    + name: string
    + category: string
    + sku: string
    + minimum_stock_threshold: number
    + supplier_name: string
    + last_restock_date: string
  }
  class CategoryResource {
    + category_id: number
    + name: string
  }
  class SupplierResource {
    + supplier_id: number
    + name: string
    + contact_person: string
    + phone: string
    + email: string
  }
  class ProductAssembler {
    + {static} toEntityFromResource(r: ProductResource): Product
    + {static} toEntitiesFromResponse(r: ProductResource[]): Product[]
    + {static} toResourceFromEntity(p: Product): ProductResource
  }
  class CategoryAssembler {
    + {static} toEntityFromResource(r: CategoryResource): Category
    + {static} toEntitiesFromResponse(r: CategoryResource[]): Category[]
  }
  class SupplierAssembler {
    + {static} toEntityFromResource(r: SupplierResource): Supplier
    + {static} toEntitiesFromResponse(r: SupplierResource[]): Supplier[]
    + {static} toResourceFromEntity(s: Supplier): SupplierResource
  }
  class ProductApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getProducts(): Promise<ProductResource[]>
    + createProduct(r: ProductResource): Promise<ProductResource>
    + updateProduct(r: ProductResource): Promise<ProductResource>
    + deleteProduct(id: number): Promise<void>
  }
  class CategoryApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getCategories(): Promise<CategoryResource[]>
  }
  class SupplierApi {
    - endpoint: BaseEndpoint
    + constructor()
    + getSuppliers(): Promise<SupplierResource[]>
    + createSupplier(r: SupplierResource): Promise<SupplierResource>
  }
}

package "inventory.application" {
  class InventoryStore {
    + products: ComputedRef<Product[]>
    + categories: ComputedRef<Category[]>
    + suppliers: ComputedRef<Supplier[]>
    + lowStockProducts: ComputedRef<Product[]>
    + loading: Ref<boolean>
    + errors: Ref<string[]>
    + loadProducts(): Promise<void>
    + loadCategories(): Promise<void>
    + loadSuppliers(): Promise<void>
    + createProduct(p: Product): Promise<void>
    + updateProduct(p: Product): Promise<void>
    + deleteProduct(id: number): Promise<void>
  }
}

package "inventory.presentation.views" {
  class InventoryListView <<view>> {
    - searchQuery: Ref<string>
    - categoryFilter: Ref<string>
    - stockLevelFilter: Ref<string>
    - showAddProduct: Ref<boolean>
    - selectedProductRestock: Ref<Product | null>
    - showBulkRestock: Ref<boolean>
    - showAuditLog: Ref<boolean>
    - summary: ComputedRef<object[]>
    + getStockStatus(stock, threshold): object
  }
}

package "inventory.presentation.components" {
  class ModalAddProduct <<component>> {
    + categories: Category[] (prop)
    + suppliers: Supplier[] (prop)
    + emit save: (product: Product)
    + emit close: void
  }
  class ModalRestock <<component>> {
    + product: Product (prop)
    + emit save: (product: Product)
    + emit close: void
  }
  class ModalBulkRestock <<component>> {
    + products: Product[] (prop)
    + emit save: void
    + emit close: void
  }
  class ModalAuditLog <<component>> {
    + logs: object[] (prop)
    + emit close: void
  }
}

BaseApi <|-- ProductApi
BaseApi <|-- CategoryApi
BaseApi <|-- SupplierApi
ProductApi --> BaseEndpoint : uses
CategoryApi --> BaseEndpoint : uses
SupplierApi --> BaseEndpoint : uses

ProductAssembler ..> ProductResource : transforms
ProductAssembler --> Product : creates
CategoryAssembler ..> CategoryResource : transforms
CategoryAssembler --> Category : creates
SupplierAssembler ..> SupplierResource : transforms
SupplierAssembler --> Supplier : creates

InventoryStore --> ProductApi : uses
InventoryStore --> CategoryApi : uses
InventoryStore --> SupplierApi : uses
InventoryStore --> ProductAssembler : uses
InventoryStore --> CategoryAssembler : uses
InventoryStore --> SupplierAssembler : uses

InventoryListView --> InventoryStore : uses
InventoryListView *-- ModalAddProduct : contains
InventoryListView *-- ModalRestock : contains
InventoryListView *-- ModalBulkRestock : contains
InventoryListView *-- ModalAuditLog : contains

note right of InventoryStore
  lowStockProducts filters products
  where stock <= 3 (hard-coded threshold).
end note

note right of ProductApi
  updateProduct uses PUT with
  product_id as the URL path segment.
end note

@enduml
