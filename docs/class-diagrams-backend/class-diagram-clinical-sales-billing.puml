@startuml
title Clinical ↔ Sales & Billing Context
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Shared Kernel" {
class "CustomerId" <<ValueObject>> {
- value : UUID
}
class "PrescriptionId" <<ValueObject>> {
- value : UUID
}
class "QuotationId" <<ValueObject>> {
- value : UUID
}
class "SaleId" <<ValueObject>> {
- value : UUID
}
class "WorkOrderId" <<ValueObject>> {
- value : UUID
}
class "DateTime" <<ValueObject>> {
- value : Date
}
class "Money" <<ValueObject>> {
- amount : decimal
- currency : Currency
--
+ add(other: Money): Money
+ subtract(other: Money): Money
}
enum Currency {
PEN
USD
}
Money -- Currency
}

package "Clinical Context" {
class "ClinicalRecordId" <<ValueObject>> {
- value : UUID
}
entity "Customer" <<AggregateRoot>> {
- id : CustomerId
--
name : String
email : String
phone : String
dni : String
birthDate : DateTime
--
+ updateContactInfo(name: String, email: String, phone: String): void
+ validateNoDuplicate(dni: String): Boolean
}
entity "ClinicalRecord" <<AggregateRoot>> {
- id : ClinicalRecordId
--
customerId : CustomerId
--
+ addPrescription(p: Prescription): void
+ getLatestPrescription(): Prescription
}
entity "Prescription" <<Entity>> {
- id : PrescriptionId
--
sphere : float
cylinder : float
axis : int
--
+ updateValues(sphere: float, cylinder: float, axis: int): void
+ validate(): Boolean
}
Customer --> CustomerId
Customer --> DateTime
ClinicalRecord --> ClinicalRecordId
ClinicalRecord --> CustomerId
ClinicalRecord *--> "0..*" Prescription
Prescription --> PrescriptionId
}

package "Sales & Billing Context" {
entity "Quotation" <<AggregateRoot>> {
- id : QuotationId
--
customerId : CustomerId
prescriptionId : PrescriptionId
total : Money
--
+ calculateTotal(): void
}
entity "Sale" <<AggregateRoot>> {
- id : SaleId
--
customerId : CustomerId
quotationId : QuotationId
workOrderId : WorkOrderId
status : SaleStatus
createdAt : DateTime
--
+ registerDeposit(amount: Money): void
+ completePayment(amount: Money): void
+ markAsDelivered(): void
+ processRefund(): void
+ calculateOutstandingBalance(): Money
+ isFullyPaid(): Boolean
}
class "Deposit" <<ValueObject>> {
- amount : Money
--
+ isValid(minPercentage: decimal, total: Money): Boolean
+ getAmount(): Money
}
class "OutstandingBalance" <<ValueObject>> {
- amount : Money
--
+ isZero(): Boolean
+ withReduction(payment: Money): OutstandingBalance
+ getAmount(): Money
}
enum SaleStatus {
PENDING
PAID
DELIVERED
REFUNDED
}
Quotation --> QuotationId
Quotation --> CustomerId
Quotation --> PrescriptionId
Quotation --> Money
Sale --> SaleId
Sale --> CustomerId
Sale --> QuotationId
Sale --> WorkOrderId
Sale --> SaleStatus
Sale --> DateTime
Sale *--> "1" Deposit
Sale *--> "1" OutstandingBalance
Deposit --> Money
OutstandingBalance --> Money
}

@enduml
