@startuml
title Inventory ↔ Sales Context
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Shared Kernel" {
class "CustomerId" <<ValueObject>> {
- value : UUID
}
class "SaleId" <<ValueObject>> {
- value : UUID
}
class "PrescriptionId" <<ValueObject>> {
- value : UUID
}
class "ProductId" <<ValueObject>> {
- value : UUID
}
class "QuotationId" <<ValueObject>> {
- value : UUID
}
class "WorkOrderId" <<ValueObject>> {
- value : UUID
}
class "DateTime" <<ValueObject>> {
- value : Date
}
class "Money" <<ValueObject>> {
- amount : decimal
- currency : Currency
--
+ add(other: Money): Money
+ subtract(other: Money): Money
}
enum Currency {
PEN
USD
}
Money -- Currency
}

package "Inventory Context" {
entity "Product" <<AggregateRoot>> {
- id : ProductId
--
sku : String
name : String
type : ProductType
price : Money
stock : Stock
details : ProductDetails
--
+ updateStock(qty: int): void
+ isAvailable(): Boolean
}
class "Stock" <<ValueObject>> {
- quantity : int
- minimumStockThreshold : int
--
+ withIncrease(qty: int): Stock
+ withDecrease(qty: int): Stock
+ isAvailable(): Boolean
+ isBelowMinimumThreshold(): Boolean
}
enum ProductType {
FRAME
LENS
CONTACT_LENS
CLEANING_KIT
SOLUTION
}
class "ProductDetails" <<ValueObject>> {
- material : String
- brand : String
- color : String
- lensType : String
- expirationDate : DateTime
- supplierName : String
--
+ getDetails(): String
}
Product --> ProductId
Product --> ProductType
Product --> Money
Product *--> "1" Stock
Product *--> "1" ProductDetails
Stock --> DateTime
}

package "Sales & Billing Context" {
entity "Quotation" <<AggregateRoot>> {
- id : QuotationId
--
customerId : CustomerId
prescriptionId : PrescriptionId
productId : ProductId
total : Money
--
+ calculateTotal(): void
}
entity "Sale" <<AggregateRoot>> {
- id : SaleId
--
customerId : CustomerId
quotationId : QuotationId
workOrderId : WorkOrderId
status : SaleStatus
createdAt : DateTime
--
+ registerDeposit(amount: Money): void
+ completePayment(amount: Money): void
+ markAsDelivered(): void
+ processRefund(): void
+ calculateOutstandingBalance(): Money
+ isFullyPaid(): Boolean
}
class "Deposit" <<ValueObject>> {
- amount : Money
--
+ isValid(minPercentage: decimal, total: Money): Boolean
+ getAmount(): Money
}
class "OutstandingBalance" <<ValueObject>> {
- amount : Money
--
+ isZero(): Boolean
+ withReduction(payment: Money): OutstandingBalance
+ getAmount(): Money
}
enum SaleStatus {
PENDING
PAID
DELIVERED
REFUNDED
}
Quotation --> QuotationId
Quotation --> CustomerId
Quotation --> PrescriptionId
Quotation --> ProductId
Quotation --> Money
Sale --> SaleId
Sale --> CustomerId
Sale --> QuotationId
Sale --> WorkOrderId
Sale --> SaleStatus
Sale --> DateTime
Sale *--> "1" Deposit
Sale *--> "1" OutstandingBalance
Deposit --> Money
OutstandingBalance --> Money
}

@enduml
