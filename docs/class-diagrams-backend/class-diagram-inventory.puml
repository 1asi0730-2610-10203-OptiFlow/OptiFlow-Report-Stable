@startuml BC_Inventory
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Inventory Context" {

  ' =========================================================
  ' INTERFACES LAYER
  ' =========================================================

  package "Interfaces.REST" {

    class ProductsController {
      -productCommandService: IProductCommandService
      -productQueryService: IProductQueryService
      +CreateProduct(resource: CreateProductResource): Task<IActionResult>
      +GetProductById(id: int): Task<IActionResult>
      +GetAllProducts(): Task<IActionResult>
      +GetProductsByType(type: string): Task<IActionResult>
    }

    class PurchaseOrdersController {
      -purchaseOrderCommandService: IPurchaseOrderCommandService
      -purchaseOrderQueryService: IPurchaseOrderQueryService
      +CreatePurchaseOrder(resource: CreatePurchaseOrderResource): Task<IActionResult>
      +ReceivePurchaseOrder(id: int): Task<IActionResult>
      +GetPurchaseOrderById(id: int): Task<IActionResult>
      +GetAllPurchaseOrders(): Task<IActionResult>
    }

    class InventoryMovementsController {
      -inventoryMovementQueryService: IInventoryMovementQueryService
      +GetMovementsByProductId(productId: int): Task<IActionResult>
      +GetAllMovements(): Task<IActionResult>
    }

    package "Resources" {

      class CreateProductResource <<record>> {
        +Sku: string
        +Name: string
        +Type: string
        +Price: decimal
        +Currency: string
        +InitialQuantity: int
        +MinimumStockThreshold: int
        +Material: string
        +Brand: string
        +Color: string
        +LensType: string
        +ExpirationDate: DateTime
        +SupplierName: string
      }

      class ProductResource <<record>> {
        +Id: int
        +Sku: string
        +Name: string
        +Type: string
        +Price: decimal
        +Currency: string
        +Quantity: int
        +MinimumStockThreshold: int
        +IsAvailable: bool
        +IsBelowThreshold: bool
      }

      class CreatePurchaseOrderResource <<record>> {
        +SupplierName: string
        +Items: IEnumerable<PurchaseOrderItemResource>
      }

      class PurchaseOrderItemResource <<record>> {
        +ProductId: int
        +RequestedQuantity: int
        +UnitPrice: decimal
        +Currency: string
      }

      class PurchaseOrderResource <<record>> {
        +Id: int
        +SupplierName: string
        +Status: string
        +CreatedAt: DateTime
        +Items: IEnumerable<PurchaseOrderItemResource>
      }

      class InventoryMovementResource <<record>> {
        +Id: int
        +ProductId: int
        +MovementType: string
        +Quantity: int
        +CreatedAt: DateTime
      }
    }

    package "Transform" {

      class CreateProductCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: CreateProductResource): CreateProductCommand
      }

      class ProductResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(product: Product): ProductResource
      }

      class CreatePurchaseOrderCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: CreatePurchaseOrderResource): CreatePurchaseOrderCommand
      }

      class PurchaseOrderResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(order: PurchaseOrder): PurchaseOrderResource
      }

      class InventoryMovementResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(movement: InventoryMovement): InventoryMovementResource
      }
    }
  }

  package "Interfaces.ACL" {

    interface IInventoryContextFacade {
      +FetchProductIdBySku(sku: string): Task<int>
      +IsProductAvailable(productId: int): Task<bool>
      +DecreaseSock(productId: int, quantity: int): Task
    }

    class InventoryContextFacade {
      -productCommandService: IProductCommandService
      -productQueryService: IProductQueryService
      +FetchProductIdBySku(sku: string): Task<int>
      +IsProductAvailable(productId: int): Task<bool>
      +DecreaseStock(productId: int, quantity: int): Task
    }
  }

  ' =========================================================
  ' APPLICATION LAYER
  ' =========================================================

  package "Application.Internal.CommandServices" {

    class ProductCommandService {
      -productRepository: IProductRepository
      -inventoryMovementRepository: IInventoryMovementRepository
      -unitOfWork: IUnitOfWork
      +Handle(command: CreateProductCommand): Task<Product?>
      +Handle(command: DecreaseStockCommand): Task<Product?>
    }

    class PurchaseOrderCommandService {
      -purchaseOrderRepository: IPurchaseOrderRepository
      -productRepository: IProductRepository
      -inventoryMovementRepository: IInventoryMovementRepository
      -unitOfWork: IUnitOfWork
      +Handle(command: CreatePurchaseOrderCommand): Task<PurchaseOrder?>
      +Handle(command: ReceivePurchaseOrderCommand): Task<PurchaseOrder?>
    }
  }

  package "Application.Internal.QueryServices" {

    class ProductQueryService {
      -productRepository: IProductRepository
      +Handle(query: GetProductByIdQuery): Task<Product?>
      +Handle(query: GetAllProductsQuery): Task<IEnumerable<Product>>
      +Handle(query: GetProductsByTypeQuery): Task<IEnumerable<Product>>
      +Handle(query: GetProductBySkuQuery): Task<Product?>
    }

    class PurchaseOrderQueryService {
      -purchaseOrderRepository: IPurchaseOrderRepository
      +Handle(query: GetPurchaseOrderByIdQuery): Task<PurchaseOrder?>
      +Handle(query: GetAllPurchaseOrdersQuery): Task<IEnumerable<PurchaseOrder>>
    }

    class InventoryMovementQueryService {
      -inventoryMovementRepository: IInventoryMovementRepository
      +Handle(query: GetMovementsByProductIdQuery): Task<IEnumerable<InventoryMovement>>
      +Handle(query: GetAllMovementsQuery): Task<IEnumerable<InventoryMovement>>
    }
  }

  ' =========================================================
  ' DOMAIN LAYER
  ' =========================================================

  package "Domain.Model.Aggregates" {

    class Product <<AggregateRoot>> {
      +Id: int
      +Sku: string
      +Name: string
      +Type: ProductType
      +Price: Money
      +Quantity: int
      +MinimumStockThreshold: int
      +Details: ProductDetails
      +Product(command: CreateProductCommand)
      +DecreaseStock(qty: int): void
      +IncreaseStock(qty: int): void
      +IsAvailable(): bool
      +IsBelowMinimumThreshold(): bool
    }

    class PurchaseOrder <<AggregateRoot>> {
      +Id: int
      +SupplierName: string
      +Status: PurchaseOrderStatus
      +CreatedAt: DateTime
      +Items: ICollection<PurchaseOrderItem>
      +PurchaseOrder(command: CreatePurchaseOrderCommand)
      +AddItem(productId: int, requestedQuantity: int, unitPrice: Money): void
      +Receive(): void
      +IsReceived(): bool
    }

    class InventoryMovement <<AggregateRoot>> {
      +Id: int
      +ProductId: int
      +MovementType: MovementType
      +Quantity: int
      +CreatedAt: DateTime
      +InventoryMovement(productId: int, movementType: MovementType, quantity: int)
    }
  }

  package "Domain.Model.Entities" {

    class PurchaseOrderItem <<Entity>> {
      +Id: int
      +PurchaseOrderId: int
      +ProductId: int
      +RequestedQuantity: int
      +UnitPrice: Money
      +PurchaseOrderItem(productId: int, requestedQuantity: int, unitPrice: Money)
    }
  }

  package "Domain.Model.ValueObjects" {

    class Money <<ValueObject>> {
      +Amount: decimal
      +Currency: Currency
      +Money(amount: decimal, currency: Currency)
      +Add(other: Money): Money
      +Subtract(other: Money): Money
    }

    class ProductDetails <<ValueObject>> {
      +Material: string
      +Brand: string
      +Color: string
      +LensType: string
      +ExpirationDate: DateTime
      +SupplierName: string
      +ProductDetails(material: string, brand: string, color: string, lensType: string, expirationDate: DateTime, supplierName: string)
      +GetDetails(): string
    }

    enum Currency {
      PEN
      USD
    }

    enum ProductType {
      FRAME
      LENS
      CONTACT_LENS
      CLEANING_KIT
      SOLUTION
    }

    enum PurchaseOrderStatus {
      PENDING
      RECEIVED
      CANCELLED
    }

    enum MovementType {
      PURCHASE_IN
      SALE_OUT
      MANUAL_ADJUSTMENT
    }
  }

  package "Domain.Model.Commands" {

    class CreateProductCommand <<record>> {
      +Sku: string
      +Name: string
      +Type: string
      +Price: decimal
      +Currency: string
      +InitialQuantity: int
      +MinimumStockThreshold: int
      +Material: string
      +Brand: string
      +Color: string
      +LensType: string
      +ExpirationDate: DateTime
      +SupplierName: string
    }

    class DecreaseStockCommand <<record>> {
      +ProductId: int
      +Quantity: int
    }

    class CreatePurchaseOrderCommand <<record>> {
      +SupplierName: string
      +Items: IEnumerable<(int ProductId, int RequestedQuantity, decimal UnitPrice, string Currency)>
    }

    class ReceivePurchaseOrderCommand <<record>> {
      +PurchaseOrderId: int
    }
  }

  package "Domain.Model.Queries" {

    class GetProductByIdQuery <<record>> {
      +Id: int
    }

    class GetAllProductsQuery <<record>>

    class GetProductsByTypeQuery <<record>> {
      +Type: string
    }

    class GetProductBySkuQuery <<record>> {
      +Sku: string
    }

    class GetPurchaseOrderByIdQuery <<record>> {
      +Id: int
    }

    class GetAllPurchaseOrdersQuery <<record>>

    class GetMovementsByProductIdQuery <<record>> {
      +ProductId: int
    }

    class GetAllMovementsQuery <<record>>
  }

  package "Domain.Services" {

    interface IProductCommandService {
      +Handle(command: CreateProductCommand): Task<Product?>
      +Handle(command: DecreaseStockCommand): Task<Product?>
    }

    interface IProductQueryService {
      +Handle(query: GetProductByIdQuery): Task<Product?>
      +Handle(query: GetAllProductsQuery): Task<IEnumerable<Product>>
      +Handle(query: GetProductsByTypeQuery): Task<IEnumerable<Product>>
      +Handle(query: GetProductBySkuQuery): Task<Product?>
    }

    interface IPurchaseOrderCommandService {
      +Handle(command: CreatePurchaseOrderCommand): Task<PurchaseOrder?>
      +Handle(command: ReceivePurchaseOrderCommand): Task<PurchaseOrder?>
    }

    interface IPurchaseOrderQueryService {
      +Handle(query: GetPurchaseOrderByIdQuery): Task<PurchaseOrder?>
      +Handle(query: GetAllPurchaseOrdersQuery): Task<IEnumerable<PurchaseOrder>>
    }

    interface IInventoryMovementQueryService {
      +Handle(query: GetMovementsByProductIdQuery): Task<IEnumerable<InventoryMovement>>
      +Handle(query: GetAllMovementsQuery): Task<IEnumerable<InventoryMovement>>
    }
  }

  package "Domain.Repositories" {

    interface IProductRepository {
      +FindBySkuAsync(sku: string): Task<Product?>
      +FindByTypeAsync(type: ProductType): Task<IEnumerable<Product>>
      +ExistsBySkuAsync(sku: string): Task<bool>
      +FindByIdAsync(id: int): Task<Product?>
      +ListAsync(): Task<IEnumerable<Product>>
      +AddAsync(product: Product): Task
      +Update(product: Product): void
      +Remove(product: Product): void
    }

    interface IPurchaseOrderRepository {
      +FindByIdAsync(id: int): Task<PurchaseOrder?>
      +ListAsync(): Task<IEnumerable<PurchaseOrder>>
      +AddAsync(order: PurchaseOrder): Task
      +Update(order: PurchaseOrder): void
    }

    interface IInventoryMovementRepository {
      +FindByProductIdAsync(productId: int): Task<IEnumerable<InventoryMovement>>
      +ListAsync(): Task<IEnumerable<InventoryMovement>>
      +AddAsync(movement: InventoryMovement): Task
    }
  }

  ' =========================================================
  ' INFRASTRUCTURE LAYER
  ' =========================================================

  package "Infrastructure.Persistence.EFC.Repositories" {

    class ProductRepository {
      +FindBySkuAsync(sku: string): Task<Product?>
      +FindByTypeAsync(type: ProductType): Task<IEnumerable<Product>>
      +ExistsBySkuAsync(sku: string): Task<bool>
    }

    class PurchaseOrderRepository {
      +FindByIdAsync(id: int): Task<PurchaseOrder?>
      +ListAsync(): Task<IEnumerable<PurchaseOrder>>
    }

    class InventoryMovementRepository {
      +FindByProductIdAsync(productId: int): Task<IEnumerable<InventoryMovement>>
    }
  }

  ' =========================================================
  ' RELATIONSHIPS
  ' =========================================================

  ' Controllers -> Services
  ProductsController --> IProductCommandService : uses
  ProductsController --> IProductQueryService : uses
  PurchaseOrdersController --> IPurchaseOrderCommandService : uses
  PurchaseOrdersController --> IPurchaseOrderQueryService : uses
  InventoryMovementsController --> IInventoryMovementQueryService : uses

  ' Controllers -> Queries
  ProductsController --> GetProductByIdQuery : creates
  ProductsController --> GetAllProductsQuery : creates
  ProductsController --> GetProductsByTypeQuery : creates
  PurchaseOrdersController --> GetPurchaseOrderByIdQuery : creates
  PurchaseOrdersController --> GetAllPurchaseOrdersQuery : creates
  InventoryMovementsController --> GetMovementsByProductIdQuery : creates
  InventoryMovementsController --> GetAllMovementsQuery : creates

  ' Assemblers
  CreateProductCommandFromResourceAssembler ..> CreateProductResource : reads
  CreateProductCommandFromResourceAssembler --> CreateProductCommand : produces
  ProductResourceFromEntityAssembler ..> Product : reads
  ProductResourceFromEntityAssembler --> ProductResource : produces
  CreatePurchaseOrderCommandFromResourceAssembler ..> CreatePurchaseOrderResource : reads
  CreatePurchaseOrderCommandFromResourceAssembler --> CreatePurchaseOrderCommand : produces
  PurchaseOrderResourceFromEntityAssembler ..> PurchaseOrder : reads
  PurchaseOrderResourceFromEntityAssembler --> PurchaseOrderResource : produces
  InventoryMovementResourceFromEntityAssembler ..> InventoryMovement : reads
  InventoryMovementResourceFromEntityAssembler --> InventoryMovementResource : produces

  ' ACL Facade
  InventoryContextFacade ..|> IInventoryContextFacade
  InventoryContextFacade --> IProductCommandService : uses
  InventoryContextFacade --> IProductQueryService : uses
  InventoryContextFacade --> DecreaseStockCommand : creates
  InventoryContextFacade --> GetProductBySkuQuery : creates
  InventoryContextFacade --> GetProductByIdQuery : creates

  ' Service Implementations
  ProductCommandService ..|> IProductCommandService
  ProductQueryService ..|> IProductQueryService
  PurchaseOrderCommandService ..|> IPurchaseOrderCommandService
  PurchaseOrderQueryService ..|> IPurchaseOrderQueryService
  InventoryMovementQueryService ..|> IInventoryMovementQueryService

  ' Command Services -> Repositories
  ProductCommandService --> IProductRepository : uses
  ProductCommandService --> IInventoryMovementRepository : uses
  PurchaseOrderCommandService --> IPurchaseOrderRepository : uses
  PurchaseOrderCommandService --> IProductRepository : uses
  PurchaseOrderCommandService --> IInventoryMovementRepository : uses
  ProductQueryService --> IProductRepository : uses
  PurchaseOrderQueryService --> IPurchaseOrderRepository : uses
  InventoryMovementQueryService --> IInventoryMovementRepository : uses

  ' Domain relationships
  Product --> ProductType : uses
  Product --> Money : uses
  Product *--> ProductDetails : contains
  PurchaseOrder *--> "1..*" PurchaseOrderItem : contains
  PurchaseOrder --> PurchaseOrderStatus : uses
  PurchaseOrderItem --> Money : uses
  InventoryMovement --> MovementType : uses
  Money --> Currency : uses

  ' Infrastructure implementations
  ProductRepository ..|> IProductRepository
  PurchaseOrderRepository ..|> IPurchaseOrderRepository
  InventoryMovementRepository ..|> IInventoryMovementRepository
}

@enduml
