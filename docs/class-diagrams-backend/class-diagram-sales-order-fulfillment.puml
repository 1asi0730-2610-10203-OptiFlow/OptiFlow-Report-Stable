@startuml
title Sales ↔ Order Fulfillment Context
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Shared Kernel" {
class "CustomerId" <<ValueObject>> {
- value : UUID
}
class "SaleId" <<ValueObject>> {
- value : UUID
}
class "PrescriptionId" <<ValueObject>> {
- value : UUID
}
class "QuotationId" <<ValueObject>> {
- value : UUID
}
class "WorkOrderId" <<ValueObject>> {
- value : UUID
}
class "DateTime" <<ValueObject>> {
- value : Date
}
class "Money" <<ValueObject>> {
- amount : decimal
- currency : Currency
--
+ add(other: Money): Money
+ subtract(other: Money): Money
}
enum Currency {
PEN
USD
}
Money -- Currency
}

package "Sales & Billing Context" {
entity "Quotation" <<AggregateRoot>> {
- id : QuotationId
--
customerId : CustomerId
prescriptionId : PrescriptionId
total : Money
--
+ calculateTotal(): void
}
entity "Sale" <<AggregateRoot>> {
- id : SaleId
--
customerId : CustomerId
quotationId : QuotationId
workOrderId : WorkOrderId
status : SaleStatus
createdAt : DateTime
--
+ registerDeposit(amount: Money): void
+ completePayment(amount: Money): void
+ markAsDelivered(): void
+ processRefund(): void
+ calculateOutstandingBalance(): Money
+ isFullyPaid(): Boolean
}
class "Deposit" <<ValueObject>> {
- amount : Money
--
+ isValid(minPercentage: decimal, total: Money): Boolean
+ getAmount(): Money
}
class "OutstandingBalance" <<ValueObject>> {
- amount : Money
--
+ isZero(): Boolean
+ withReduction(payment: Money): OutstandingBalance
+ getAmount(): Money
}
enum SaleStatus {
PENDING
PAID
DELIVERED
REFUNDED
}
Quotation --> QuotationId
Quotation --> CustomerId
Quotation --> PrescriptionId
Quotation --> Money
Sale --> SaleId
Sale --> CustomerId
Sale --> QuotationId
Sale --> WorkOrderId
Sale --> SaleStatus
Sale --> DateTime
Sale *--> "1" Deposit
Sale *--> "1" OutstandingBalance
Deposit --> Money
OutstandingBalance --> Money
}

package "Order Fulfillment Context" {
entity "WorkOrder" <<AggregateRoot>> {
- id : WorkOrderId
--
saleId : SaleId
prescriptionId : PrescriptionId
status : OrderStatus
priority : OrderPriority
isRework : Boolean
estimatedDate : DateTime
createdAt : DateTime
--
+ updateStatus(newStatus: OrderStatus): void
+ markAsRework(): void
+ escalatePriority(): void
+ validateTransition(to: OrderStatus): Boolean
+ isDelivered(): Boolean
}
class "KanbanFlow" <<DomainService>> {
+ moveTo(order: WorkOrder, newStatus: OrderStatus): WorkOrder
+ validateTransition(from: OrderStatus, to: OrderStatus): Boolean
+ isBackward(from: OrderStatus, to: OrderStatus): Boolean
}
enum OrderStatus {
RECEIVED
IN_PRODUCTION
QUALITY_CONTROL
READY_FOR_DELIVERY
DELIVERED
}
enum OrderPriority {
NORMAL
HIGH
URGENT
}
WorkOrder --> WorkOrderId
WorkOrder --> SaleId
WorkOrder --> PrescriptionId
WorkOrder --> OrderStatus
WorkOrder --> OrderPriority
WorkOrder --> DateTime
KanbanFlow ..> WorkOrder : uses
KanbanFlow --> OrderStatus
}

@enduml
