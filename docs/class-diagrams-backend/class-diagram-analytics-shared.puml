@startuml
title Analytics Context
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Shared Kernel" {
class "DateTime" <<ValueObject>> {
- value : Date
}
class "Money" <<ValueObject>> {
- amount : decimal
- currency : Currency
--
+ add(other: Money): Money
+ subtract(other: Money): Money
}
enum Currency {
PEN
USD
}
Money -- Currency
}

package "Analytics Context" {

class "AnalyticsReportId" <<ValueObject>> {
- value : UUID
}

class "AnalyticsReport" <<AggregateRoot>> {
- id : AnalyticsReportId
- generatedAt : DateTime
- period : String
--
- conversionMetric : ConversionMetric
- salesMetric : SalesMetric
- labMetric : LabMetric
- staffMetric : StaffMetric
- pendingBalanceMetric : PendingBalanceMetric
--
+ generateReport(): void
}

class "ConversionMetric" <<ValueObject>> {
- prescriptionsIssued : int
- salesClosed : int
--
+ getConversionRate(): decimal
}

class "SalesMetric" <<ValueObject>> {
- totalRevenue : Money
- totalTransactions : int
- revenueByCategory : String
--
+ calculateAverageTicket(): Money
}

class "LabMetric" <<ValueObject>> {
- averageProductionDays : decimal
- onTimeDeliveryRate : decimal
- reworkRate : decimal
- totalOrders : int
- reworkCauses : String
--
+ getOnTimeRate(): decimal
+ getReworkRate(): decimal
}

class "StaffMetric" <<ValueObject>> {
- employeeName : String
- quotationsIssued : int
- salesClosed : int
- totalRevenue : Money
--
+ getConversionRate(): decimal
}

class "PendingBalanceMetric" <<ValueObject>> {
- balanceZeroToSeven : Money
- balanceEightToFifteen : Money
- balanceSixteenToThirty : Money
- balanceOverThirty : Money
--
+ getTotalPending(): Money
}

AnalyticsReport --> AnalyticsReportId
AnalyticsReport --> DateTime
AnalyticsReport *--> "1" ConversionMetric
AnalyticsReport *--> "1" SalesMetric
AnalyticsReport *--> "1" LabMetric
AnalyticsReport *--> "1..* " StaffMetric
AnalyticsReport *--> "1" PendingBalanceMetric
SalesMetric --> Money
StaffMetric --> Money
PendingBalanceMetric --> Money
}

@enduml
