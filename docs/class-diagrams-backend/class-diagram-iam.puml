@startuml BC_IAM
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "IAM" {

  ' =========================================================
  ' INTERFACES LAYER
  ' =========================================================

  package "Interfaces.REST" {

    class AuthenticationController {
      -userCommandService: IUserCommandService
      +SignIn(signInResource: SignInResource): Task<IActionResult>
      +SignUp(signUpResource: SignUpResource): Task<IActionResult>
    }

    class EmployeesController {
      -userQueryService: IUserQueryService
      +GetEmployeeById(id: int): Task<IActionResult>
      +GetAllEmployees(): Task<IActionResult>
    }

    package "Interfaces.REST.Resources" {

      class SignInResource <<record>> {
        +Username: string
        +Password: string
      }

      class SignUpResource <<record>> {
        +Username: string
        +Password: string
        +Name: string
        +Email: string
        +Phone: string
        +Department: string
        +Role: string
      }

      class AuthenticatedEmployeeResource <<record>> {
        +Id: int
        +Username: string
        +Token: string
      }

      class EmployeeResource <<record>> {
        +Id: int
        +Username: string
        +Name: string
        +Email: string
        +Phone: string
        +Department: string
        +Role: string
        +Status: string
      }
    }

    package "Interfaces.REST.Transform" {

      class SignInCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: SignInResource): SignInCommand
      }

      class SignUpCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: SignUpResource): SignUpCommand
      }

      class AuthenticatedEmployeeResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(employee: OpticalEmployee, token: string): AuthenticatedEmployeeResource
      }

      class EmployeeResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(employee: OpticalEmployee): EmployeeResource
      }
    }
  }

  package "Interfaces.ACL" {

    interface IIamContextFacade {
      +CreateUser(username: string, password: string): Task<int>
      +FetchUserIdByUsername(username: string): Task<int>
      +FetchUsernameByUserId(userId: int): Task<string>
    }

    class IamContextFacade {
      -userCommandService: IUserCommandService
      -userQueryService: IUserQueryService
      +CreateUser(username: string, password: string): Task<int>
      +FetchUserIdByUsername(username: string): Task<int>
      +FetchUsernameByUserId(userId: int): Task<string>
    }
  }

  ' =========================================================
  ' APPLICATION LAYER
  ' =========================================================

  package "Application.Internal.CommandServices" {

    class UserCommandService {
      -userRepository: IUserRepository
      -tokenService: ITokenService
      -hashingService: IHashingService
      -unitOfWork: IUnitOfWork
      +Handle(command: SignInCommand): Task<(OpticalEmployee, string)>
      +Handle(command: SignUpCommand): Task
      +Handle(command: DeactivateEmployeeCommand): Task
      +Handle(command: ChangePasswordCommand): Task
    }
  }

  package "Application.Internal.QueryServices" {

    class UserQueryService {
      -userRepository: IUserRepository
      +Handle(query: GetEmployeeByIdQuery): Task<OpticalEmployee?>
      +Handle(query: GetAllEmployeesQuery): Task<IEnumerable<OpticalEmployee>>
      +Handle(query: GetEmployeeByUsernameQuery): Task<OpticalEmployee?>
    }
  }

  package "Application.Internal.OutboundServices" {

    interface IHashingService {
      +HashPassword(password: string): string
      +VerifyPassword(password: string, passwordHash: string): bool
    }

    interface ITokenService {
      +GenerateToken(employee: OpticalEmployee): string
      +ValidateToken(token: string): Task<int?>
    }
  }

  ' =========================================================
  ' DOMAIN LAYER
  ' =========================================================

  package "Domain.Model.Aggregates" {

    class OpticalEmployee <<AggregateRoot>> {
      +Id: int
      +Username: string
      -PasswordHash: string
      +Name: string
      +Email: string
      +Phone: string
      +Department: string
      +Role: EmployeeRole
      +Status: EmployeeStatus
      +HireDate: DateTime
      +Permissions: string
      +OpticalEmployee(command: SignUpCommand)
      +UpdateUsername(username: string): OpticalEmployee
      +UpdatePasswordHash(passwordHash: string): OpticalEmployee
      +Deactivate(): void
      +ChangePassword(newPasswordHash: string): void
      +ValidateCredentials(password: string, hashingService: IHashingService): bool
    }
  }

  package "Domain.Model.Commands" {

    class SignInCommand <<record>> {
      +Username: string
      +Password: string
    }

    class SignUpCommand <<record>> {
      +Username: string
      +Password: string
      +Name: string
      +Email: string
      +Phone: string
      +Department: string
      +Role: string
    }

    class DeactivateEmployeeCommand <<record>> {
      +EmployeeId: int
    }

    class ChangePasswordCommand <<record>> {
      +EmployeeId: int
      +NewPassword: string
    }
  }

  package "Domain.Model.Queries" {

    class GetEmployeeByIdQuery <<record>> {
      +Id: int
    }

    class GetAllEmployeesQuery <<record>>

    class GetEmployeeByUsernameQuery <<record>> {
      +Username: string
    }
  }

  package "Domain.Model.ValueObjects" {

    enum EmployeeRole {
      ADMIN
      SALES_ADVISOR
      OPTOMETRIST
      LAB_TECHNICIAN
    }

    enum EmployeeStatus {
      ACTIVE
      INACTIVE
    }
  }

  package "Domain.Repositories" {

    interface IUserRepository {
      +FindByUsernameAsync(username: string): Task<OpticalEmployee?>
      +ExistsByUsername(username: string): bool
      +FindByIdAsync(id: int): Task<OpticalEmployee?>
      +ListAsync(): Task<IEnumerable<OpticalEmployee>>
      +AddAsync(employee: OpticalEmployee): Task
      +Update(employee: OpticalEmployee): void
      +Remove(employee: OpticalEmployee): void
    }
  }

  package "Domain.Services" {

    interface IUserCommandService {
      +Handle(command: SignInCommand): Task<(OpticalEmployee, string)>
      +Handle(command: SignUpCommand): Task
      +Handle(command: DeactivateEmployeeCommand): Task
      +Handle(command: ChangePasswordCommand): Task
    }

    interface IUserQueryService {
      +Handle(query: GetEmployeeByIdQuery): Task<OpticalEmployee?>
      +Handle(query: GetAllEmployeesQuery): Task<IEnumerable<OpticalEmployee>>
      +Handle(query: GetEmployeeByUsernameQuery): Task<OpticalEmployee?>
    }
  }

  ' =========================================================
  ' INFRASTRUCTURE LAYER
  ' =========================================================

  package "Infrastructure.Persistence.EFC.Repositories" {

    class UserRepository {
      +FindByUsernameAsync(username: string): Task<OpticalEmployee?>
      +ExistsByUsername(username: string): bool
    }
  }

  package "Infrastructure.Tokens.JWT.Services" {

    class TokenService {
      -tokenSettings: TokenSettings
      +GenerateToken(employee: OpticalEmployee): string
      +ValidateToken(token: string): Task<int?>
    }
  }

  package "Infrastructure.Hashing.BCrypt.Services" {

    class HashingService {
      +HashPassword(password: string): string
      +VerifyPassword(password: string, passwordHash: string): bool
    }
  }

  package "Infrastructure.Pipeline.Middleware" {

    class RequestAuthorizationMiddleware {
      -next: RequestDelegate
      +InvokeAsync(context: HttpContext, userQueryService: IUserQueryService, tokenService: ITokenService): Task
    }
  }
}

' =========================================================
' RELATIONSHIPS
' =========================================================

' Controllers -> Services + Assemblers
AuthenticationController --> IUserCommandService : uses
AuthenticationController --> SignInCommandFromResourceAssembler : uses
AuthenticationController --> SignUpCommandFromResourceAssembler : uses
AuthenticationController --> AuthenticatedEmployeeResourceFromEntityAssembler : uses

EmployeesController --> IUserQueryService : uses
EmployeesController --> EmployeeResourceFromEntityAssembler : uses

' Controllers -> Queries
EmployeesController --> GetEmployeeByIdQuery : creates
EmployeesController --> GetAllEmployeesQuery : creates

' Assemblers reads/produces
SignInCommandFromResourceAssembler ..> SignInResource : reads
SignInCommandFromResourceAssembler --> SignInCommand : produces

SignUpCommandFromResourceAssembler ..> SignUpResource : reads
SignUpCommandFromResourceAssembler --> SignUpCommand : produces

AuthenticatedEmployeeResourceFromEntityAssembler ..> OpticalEmployee : reads
AuthenticatedEmployeeResourceFromEntityAssembler --> AuthenticatedEmployeeResource : produces

EmployeeResourceFromEntityAssembler ..> OpticalEmployee : reads
EmployeeResourceFromEntityAssembler --> EmployeeResource : produces

' Commands -> Aggregate
SignUpCommand --> OpticalEmployee : constructs

' ACL Facade
IamContextFacade ..|> IIamContextFacade
IamContextFacade --> IUserCommandService : uses
IamContextFacade --> IUserQueryService : uses
IamContextFacade --> SignUpCommand : creates
IamContextFacade --> GetEmployeeByUsernameQuery : creates
IamContextFacade --> GetEmployeeByIdQuery : creates

' Service implementations -> Interfaces
UserCommandService ..|> IUserCommandService
UserQueryService ..|> IUserQueryService

' Command/Query Services -> Repositories + Outbound
UserCommandService --> IUserRepository : uses
UserCommandService --> ITokenService : uses
UserCommandService --> IHashingService : uses

UserQueryService --> IUserRepository : uses

' Infrastructure implementations
UserRepository ..|> IUserRepository
TokenService ..|> ITokenService
HashingService ..|> IHashingService

' Middleware
RequestAuthorizationMiddleware --> IUserQueryService : uses
RequestAuthorizationMiddleware --> ITokenService : uses
RequestAuthorizationMiddleware --> GetEmployeeByIdQuery : creates

' Aggregate value objects
OpticalEmployee --> EmployeeRole
OpticalEmployee --> EmployeeStatus

@enduml
