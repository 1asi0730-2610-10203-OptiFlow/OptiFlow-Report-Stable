@startuml BC_OrderFulfillment
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Order Fulfillment Context" {

  ' =========================================================
  ' INTERFACES LAYER
  ' =========================================================

  package "Interfaces.REST" {

    class WorkOrdersController {
      -workOrderCommandService: IWorkOrderCommandService
      -workOrderQueryService: IWorkOrderQueryService
      +CreateWorkOrder(resource: CreateWorkOrderResource): Task<IActionResult>
      +UpdateWorkOrderStatus(id: int, resource: UpdateWorkOrderStatusResource): Task<IActionResult>
      +MarkAsRework(id: int): Task<IActionResult>
      +EscalatePriority(id: int): Task<IActionResult>
      +GetWorkOrderById(id: int): Task<IActionResult>
      +GetAllWorkOrders(): Task<IActionResult>
      +GetWorkOrdersBySaleId(saleId: int): Task<IActionResult>
      +GetWorkOrdersByStatus(status: string): Task<IActionResult>
    }

    package "Resources" {

      class CreateWorkOrderResource <<record>> {
        +SaleId: int
        +PrescriptionId: int
        +Priority: string
        +EstimatedDate: DateTime
      }

      class UpdateWorkOrderStatusResource <<record>> {
        +NewStatus: string
      }

      class WorkOrderResource <<record>> {
        +Id: int
        +SaleId: int
        +PrescriptionId: int
        +Status: string
        +Priority: string
        +IsRework: bool
        +EstimatedDate: DateTime
        +CreatedAt: DateTime
      }
    }

    package "Transform" {

      class CreateWorkOrderCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: CreateWorkOrderResource): CreateWorkOrderCommand
      }

      class UpdateWorkOrderStatusCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: UpdateWorkOrderStatusResource, workOrderId: int): UpdateWorkOrderStatusCommand
      }

      class WorkOrderResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(workOrder: WorkOrder): WorkOrderResource
      }
    }
  }

  package "Interfaces.ACL" {

    interface IOrderFulfillmentContextFacade {
      +CreateWorkOrder(saleId: int, prescriptionId: int): Task<int>
      +FetchWorkOrderIdBySaleId(saleId: int): Task<int>
    }

    class OrderFulfillmentContextFacade {
      -workOrderCommandService: IWorkOrderCommandService
      -workOrderQueryService: IWorkOrderQueryService
      +CreateWorkOrder(saleId: int, prescriptionId: int): Task<int>
      +FetchWorkOrderIdBySaleId(saleId: int): Task<int>
    }
  }

  ' =========================================================
  ' APPLICATION LAYER
  ' =========================================================

  package "Application.Internal.CommandServices" {

    class WorkOrderCommandService {
      -workOrderRepository: IWorkOrderRepository
      -kanbanFlow: KanbanFlow
      -unitOfWork: IUnitOfWork
      +Handle(command: CreateWorkOrderCommand): Task<WorkOrder?>
      +Handle(command: UpdateWorkOrderStatusCommand): Task<WorkOrder?>
      +Handle(command: MarkAsReworkCommand): Task<WorkOrder?>
      +Handle(command: EscalatePriorityCommand): Task<WorkOrder?>
    }
  }

  package "Application.Internal.QueryServices" {

    class WorkOrderQueryService {
      -workOrderRepository: IWorkOrderRepository
      +Handle(query: GetWorkOrderByIdQuery): Task<WorkOrder?>
      +Handle(query: GetAllWorkOrdersQuery): Task<IEnumerable<WorkOrder>>
      +Handle(query: GetWorkOrdersBySaleIdQuery): Task<IEnumerable<WorkOrder>>
      +Handle(query: GetWorkOrdersByStatusQuery): Task<IEnumerable<WorkOrder>>
    }
  }

  ' =========================================================
  ' DOMAIN LAYER
  ' =========================================================

  package "Domain.Model.Aggregates" {

    class WorkOrder <<AggregateRoot>> {
      +Id: int
      +SaleId: int
      +PrescriptionId: int
      +Status: OrderStatus
      +Priority: OrderPriority
      +IsRework: bool
      +EstimatedDate: DateTime
      +CreatedAt: DateTime
      +WorkOrder(command: CreateWorkOrderCommand)
      +UpdateStatus(newStatus: OrderStatus): void
      +MarkAsRework(): void
      +EscalatePriority(): void
      +ValidateTransition(to: OrderStatus): bool
      +IsDelivered(): bool
    }
  }

  package "Domain.Model.ValueObjects" {

    enum OrderStatus {
      RECEIVED
      IN_PRODUCTION
      QUALITY_CONTROL
      READY_FOR_DELIVERY
      DELIVERED
    }

    enum OrderPriority {
      NORMAL
      HIGH
      URGENT
    }
  }

  package "Domain.Model.Commands" {

    class CreateWorkOrderCommand <<record>> {
      +SaleId: int
      +PrescriptionId: int
      +Priority: string
      +EstimatedDate: DateTime
    }

    class UpdateWorkOrderStatusCommand <<record>> {
      +WorkOrderId: int
      +NewStatus: string
    }

    class MarkAsReworkCommand <<record>> {
      +WorkOrderId: int
    }

    class EscalatePriorityCommand <<record>> {
      +WorkOrderId: int
    }
  }

  package "Domain.Model.Queries" {

    class GetWorkOrderByIdQuery <<record>> {
      +Id: int
    }

    class GetAllWorkOrdersQuery <<record>>

    class GetWorkOrdersBySaleIdQuery <<record>> {
      +SaleId: int
    }

    class GetWorkOrdersByStatusQuery <<record>> {
      +Status: string
    }
  }

  package "Domain.Services" {

    interface IWorkOrderCommandService {
      +Handle(command: CreateWorkOrderCommand): Task<WorkOrder?>
      +Handle(command: UpdateWorkOrderStatusCommand): Task<WorkOrder?>
      +Handle(command: MarkAsReworkCommand): Task<WorkOrder?>
      +Handle(command: EscalatePriorityCommand): Task<WorkOrder?>
    }

    interface IWorkOrderQueryService {
      +Handle(query: GetWorkOrderByIdQuery): Task<WorkOrder?>
      +Handle(query: GetAllWorkOrdersQuery): Task<IEnumerable<WorkOrder>>
      +Handle(query: GetWorkOrdersBySaleIdQuery): Task<IEnumerable<WorkOrder>>
      +Handle(query: GetWorkOrdersByStatusQuery): Task<IEnumerable<WorkOrder>>
    }

    class KanbanFlow <<DomainService>> {
      +MoveTo(order: WorkOrder, newStatus: OrderStatus): WorkOrder
      +ValidateTransition(from: OrderStatus, to: OrderStatus): bool
      +IsBackward(from: OrderStatus, to: OrderStatus): bool
    }
  }

  package "Domain.Repositories" {

    interface IWorkOrderRepository {
      +FindBySaleIdAsync(saleId: int): Task<IEnumerable<WorkOrder>>
      +FindByStatusAsync(status: OrderStatus): Task<IEnumerable<WorkOrder>>
      +FindByIdAsync(id: int): Task<WorkOrder?>
      +ListAsync(): Task<IEnumerable<WorkOrder>>
      +AddAsync(workOrder: WorkOrder): Task
      +Update(workOrder: WorkOrder): void
    }
  }

  ' =========================================================
  ' INFRASTRUCTURE LAYER
  ' =========================================================

  package "Infrastructure.Persistence.EFC.Repositories" {

    class WorkOrderRepository {
      +FindBySaleIdAsync(saleId: int): Task<IEnumerable<WorkOrder>>
      +FindByStatusAsync(status: OrderStatus): Task<IEnumerable<WorkOrder>>
    }
  }

  ' =========================================================
  ' RELATIONSHIPS
  ' =========================================================

  WorkOrdersController --> IWorkOrderCommandService : uses
  WorkOrdersController --> IWorkOrderQueryService : uses
  WorkOrdersController --> GetWorkOrderByIdQuery : creates
  WorkOrdersController --> GetAllWorkOrdersQuery : creates
  WorkOrdersController --> GetWorkOrdersBySaleIdQuery : creates
  WorkOrdersController --> GetWorkOrdersByStatusQuery : creates

  CreateWorkOrderCommandFromResourceAssembler ..> CreateWorkOrderResource : reads
  CreateWorkOrderCommandFromResourceAssembler --> CreateWorkOrderCommand : produces
  UpdateWorkOrderStatusCommandFromResourceAssembler ..> UpdateWorkOrderStatusResource : reads
  UpdateWorkOrderStatusCommandFromResourceAssembler --> UpdateWorkOrderStatusCommand : produces
  WorkOrderResourceFromEntityAssembler ..> WorkOrder : reads
  WorkOrderResourceFromEntityAssembler --> WorkOrderResource : produces

  OrderFulfillmentContextFacade ..|> IOrderFulfillmentContextFacade
  OrderFulfillmentContextFacade --> IWorkOrderCommandService : uses
  OrderFulfillmentContextFacade --> IWorkOrderQueryService : uses
  OrderFulfillmentContextFacade --> CreateWorkOrderCommand : creates
  OrderFulfillmentContextFacade --> GetWorkOrdersBySaleIdQuery : creates

  WorkOrderCommandService ..|> IWorkOrderCommandService
  WorkOrderQueryService ..|> IWorkOrderQueryService
  WorkOrderCommandService --> IWorkOrderRepository : uses
  WorkOrderCommandService --> KanbanFlow : uses
  WorkOrderQueryService --> IWorkOrderRepository : uses

  WorkOrder --> OrderStatus : uses
  WorkOrder --> OrderPriority : uses
  KanbanFlow ..> WorkOrder : orchestrates
  KanbanFlow --> OrderStatus : validates

  WorkOrderRepository ..|> IWorkOrderRepository
}

@enduml
