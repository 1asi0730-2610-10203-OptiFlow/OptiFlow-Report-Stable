@startuml
title Order Fulfillment ↔ CRM Context
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Shared Kernel" {
class "CustomerId" <<ValueObject>> {
- value : UUID
}
class "SaleId" <<ValueObject>> {
- value : UUID
}
class "PrescriptionId" <<ValueObject>> {
- value : UUID
}
class "WorkOrderId" <<ValueObject>> {
- value : UUID
}
class "DateTime" <<ValueObject>> {
- value : Date
}
}

package "Order Fulfillment Context" {

entity "WorkOrder" <<AggregateRoot>> {
- id : WorkOrderId
--
saleId : SaleId
prescriptionId : PrescriptionId
status : OrderStatus
priority : OrderPriority
isRework : Boolean
estimatedDate : DateTime
createdAt : DateTime
--
+ updateStatus(newStatus: OrderStatus): void
+ markAsRework(): void
+ escalatePriority(): void
+ validateTransition(to: OrderStatus): Boolean
+ isDelivered(): Boolean
}
class "KanbanFlow" <<DomainService>> {
+ moveTo(order: WorkOrder, newStatus: OrderStatus): WorkOrder
+ validateTransition(from: OrderStatus, to: OrderStatus): Boolean
+ isBackward(from: OrderStatus, to: OrderStatus): Boolean
}
enum OrderStatus {
RECEIVED
IN_PRODUCTION
QUALITY_CONTROL
READY_FOR_DELIVERY
DELIVERED
}
enum OrderPriority {
NORMAL
HIGH
URGENT
}
WorkOrder --> WorkOrderId
WorkOrder --> SaleId
WorkOrder --> PrescriptionId
WorkOrder --> OrderStatus
WorkOrder --> OrderPriority
WorkOrder --> DateTime
KanbanFlow ..> WorkOrder : uses
KanbanFlow --> OrderStatus
}

package "CRM & Notifications Context" {
class "NotificationId" <<ValueObject>> {
- value : UUID
}
entity "Notification" <<AggregateRoot>> {
- id : NotificationId
--
customerId : CustomerId
workOrderId : WorkOrderId
message : String
status : NotificationStatus
createdAt : DateTime
--
+ markAsSent(): void
+ markAsFailed(): void
}
interface "INotificationService" {
+ send(notification: Notification): void
}
class "SmsNotificationService" <<Service>> {
}
class "EmailNotificationService" <<Service>> {
}
class "ExternalSmsSystem" <<external>> {
}
class "Gmail" <<external>> {
}
enum NotificationStatus {
PENDING
SENT
FAILED
}
Notification --> NotificationId
Notification --> CustomerId
Notification --> WorkOrderId
Notification --> NotificationStatus
Notification --> DateTime
SmsNotificationService ..|> INotificationService
EmailNotificationService ..|> INotificationService
INotificationService ..> Notification : uses
SmsNotificationService --> ExternalSmsSystem
EmailNotificationService --> Gmail
}

@enduml
