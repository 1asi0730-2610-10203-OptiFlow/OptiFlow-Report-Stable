@startuml BC_Analytics
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Analytics Context" {

  ' =========================================================
  ' INTERFACES LAYER
  ' =========================================================

  package "Interfaces.REST" {

    class AnalyticsReportsController {
      -analyticsReportCommandService: IAnalyticsReportCommandService
      -analyticsReportQueryService: IAnalyticsReportQueryService
      +GenerateReport(resource: GenerateReportResource): Task<IActionResult>
      +GetReportById(id: int): Task<IActionResult>
      +GetAllReports(): Task<IActionResult>
      +GetReportsByPeriod(period: string): Task<IActionResult>
    }

    package "Resources" {

      class GenerateReportResource <<record>> {
        +Period: string
        +StartDate: DateTime
        +EndDate: DateTime
      }

      class AnalyticsReportResource <<record>> {
        +Id: int
        +Period: string
        +GeneratedAt: DateTime
        +ConversionRate: decimal
        +TotalRevenue: decimal
        +Currency: string
        +TotalTransactions: int
        +AverageTicket: decimal
        +AverageProductionDays: decimal
        +OnTimeDeliveryRate: decimal
        +ReworkRate: decimal
        +TotalOrders: int
        +TotalPendingBalance: decimal
      }
    }

    package "Transform" {

      class GenerateReportCommandFromResourceAssembler <<static>> {
        +ToCommandFromResource(resource: GenerateReportResource): GenerateReportCommand
      }

      class AnalyticsReportResourceFromEntityAssembler <<static>> {
        +ToResourceFromEntity(report: AnalyticsReport): AnalyticsReportResource
      }
    }
  }

  ' =========================================================
  ' APPLICATION LAYER
  ' =========================================================

  package "Application.Internal.CommandServices" {

    class AnalyticsReportCommandService {
      -analyticsReportRepository: IAnalyticsReportRepository
      -analyticsDataAggregator: IAnalyticsDataAggregator
      -unitOfWork: IUnitOfWork
      +Handle(command: GenerateReportCommand): Task<AnalyticsReport?>
    }
  }

  package "Application.Internal.QueryServices" {

    class AnalyticsReportQueryService {
      -analyticsReportRepository: IAnalyticsReportRepository
      +Handle(query: GetReportByIdQuery): Task<AnalyticsReport?>
      +Handle(query: GetAllReportsQuery): Task<IEnumerable<AnalyticsReport>>
      +Handle(query: GetReportsByPeriodQuery): Task<IEnumerable<AnalyticsReport>>
    }
  }

  package "Application.Internal.OutboundServices" {

    interface IAnalyticsDataAggregator {
      +FetchConversionData(startDate: DateTime, endDate: DateTime): Task<ConversionMetric>
      +FetchSalesData(startDate: DateTime, endDate: DateTime): Task<SalesMetric>
      +FetchLabData(startDate: DateTime, endDate: DateTime): Task<LabMetric>
      +FetchStaffData(startDate: DateTime, endDate: DateTime): Task<IEnumerable<StaffMetric>>
      +FetchPendingBalanceData(startDate: DateTime, endDate: DateTime): Task<PendingBalanceMetric>
    }
  }

  ' =========================================================
  ' DOMAIN LAYER
  ' =========================================================

  package "Domain.Model.Aggregates" {

    class AnalyticsReport <<AggregateRoot>> {
      +Id: int
      +Period: string
      +GeneratedAt: DateTime
      +ConversionMetric: ConversionMetric
      +SalesMetric: SalesMetric
      +LabMetric: LabMetric
      +StaffMetrics: ICollection<StaffMetric>
      +PendingBalanceMetric: PendingBalanceMetric
      +AnalyticsReport(command: GenerateReportCommand)
      +GenerateReport(conversion: ConversionMetric, sales: SalesMetric, lab: LabMetric, staff: IEnumerable<StaffMetric>, pending: PendingBalanceMetric): void
    }
  }

  package "Domain.Model.ValueObjects" {

    class Money <<ValueObject>> {
      +Amount: decimal
      +Currency: Currency
      +Money(amount: decimal, currency: Currency)
      +Add(other: Money): Money
      +Subtract(other: Money): Money
    }

    class ConversionMetric <<ValueObject>> {
      +PrescriptionsIssued: int
      +SalesClosed: int
      +ConversionMetric(prescriptionsIssued: int, salesClosed: int)
      +GetConversionRate(): decimal
    }

    class SalesMetric <<ValueObject>> {
      +TotalRevenue: Money
      +TotalTransactions: int
      +RevenueByCategory: string
      +SalesMetric(totalRevenue: Money, totalTransactions: int, revenueByCategory: string)
      +CalculateAverageTicket(): Money
    }

    class LabMetric <<ValueObject>> {
      +AverageProductionDays: decimal
      +OnTimeDeliveryRate: decimal
      +ReworkRate: decimal
      +TotalOrders: int
      +ReworkCauses: string
      +LabMetric(averageProductionDays: decimal, onTimeDeliveryRate: decimal, reworkRate: decimal, totalOrders: int, reworkCauses: string)
      +GetOnTimeRate(): decimal
      +GetReworkRate(): decimal
    }

    class StaffMetric <<ValueObject>> {
      +EmployeeName: string
      +QuotationsIssued: int
      +SalesClosed: int
      +TotalRevenue: Money
      +StaffMetric(employeeName: string, quotationsIssued: int, salesClosed: int, totalRevenue: Money)
      +GetConversionRate(): decimal
    }

    class PendingBalanceMetric <<ValueObject>> {
      +BalanceZeroToSeven: Money
      +BalanceEightToFifteen: Money
      +BalanceSixteenToThirty: Money
      +BalanceOverThirty: Money
      +PendingBalanceMetric(zeroToSeven: Money, eightToFifteen: Money, sixteenToThirty: Money, overThirty: Money)
      +GetTotalPending(): Money
    }

    enum Currency {
      PEN
      USD
    }
  }

  package "Domain.Model.Commands" {

    class GenerateReportCommand <<record>> {
      +Period: string
      +StartDate: DateTime
      +EndDate: DateTime
    }
  }

  package "Domain.Model.Queries" {

    class GetReportByIdQuery <<record>> {
      +Id: int
    }

    class GetAllReportsQuery <<record>>

    class GetReportsByPeriodQuery <<record>> {
      +Period: string
    }
  }

  package "Domain.Services" {

    interface IAnalyticsReportCommandService {
      +Handle(command: GenerateReportCommand): Task<AnalyticsReport?>
    }

    interface IAnalyticsReportQueryService {
      +Handle(query: GetReportByIdQuery): Task<AnalyticsReport?>
      +Handle(query: GetAllReportsQuery): Task<IEnumerable<AnalyticsReport>>
      +Handle(query: GetReportsByPeriodQuery): Task<IEnumerable<AnalyticsReport>>
    }
  }

  package "Domain.Repositories" {

    interface IAnalyticsReportRepository {
      +FindByPeriodAsync(period: string): Task<IEnumerable<AnalyticsReport>>
      +FindByIdAsync(id: int): Task<AnalyticsReport?>
      +ListAsync(): Task<IEnumerable<AnalyticsReport>>
      +AddAsync(report: AnalyticsReport): Task
      +Update(report: AnalyticsReport): void
    }
  }

  ' =========================================================
  ' INFRASTRUCTURE LAYER
  ' =========================================================

  package "Infrastructure.Persistence.EFC.Repositories" {

    class AnalyticsReportRepository {
      +FindByPeriodAsync(period: string): Task<IEnumerable<AnalyticsReport>>
    }

    class AnalyticsDataAggregator {
      +FetchConversionData(startDate: DateTime, endDate: DateTime): Task<ConversionMetric>
      +FetchSalesData(startDate: DateTime, endDate: DateTime): Task<SalesMetric>
      +FetchLabData(startDate: DateTime, endDate: DateTime): Task<LabMetric>
      +FetchStaffData(startDate: DateTime, endDate: DateTime): Task<IEnumerable<StaffMetric>>
      +FetchPendingBalanceData(startDate: DateTime, endDate: DateTime): Task<PendingBalanceMetric>
    }
  }

  ' =========================================================
  ' RELATIONSHIPS
  ' =========================================================

  ' Controllers -> Services
  AnalyticsReportsController --> IAnalyticsReportCommandService : uses
  AnalyticsReportsController --> IAnalyticsReportQueryService : uses

  ' Controllers -> Queries
  AnalyticsReportsController --> GetReportByIdQuery : creates
  AnalyticsReportsController --> GetAllReportsQuery : creates
  AnalyticsReportsController --> GetReportsByPeriodQuery : creates

  ' Assemblers
  GenerateReportCommandFromResourceAssembler ..> GenerateReportResource : reads
  GenerateReportCommandFromResourceAssembler --> GenerateReportCommand : produces
  AnalyticsReportResourceFromEntityAssembler ..> AnalyticsReport : reads
  AnalyticsReportResourceFromEntityAssembler --> AnalyticsReportResource : produces

  ' Service Implementations
  AnalyticsReportCommandService ..|> IAnalyticsReportCommandService
  AnalyticsReportQueryService ..|> IAnalyticsReportQueryService

  ' Command/Query Services -> Repositories + Outbound
  AnalyticsReportCommandService --> IAnalyticsReportRepository : uses
  AnalyticsReportCommandService --> IAnalyticsDataAggregator : uses
  AnalyticsReportQueryService --> IAnalyticsReportRepository : uses

  ' Domain relationships
  AnalyticsReport *--> "1" ConversionMetric : contains
  AnalyticsReport *--> "1" SalesMetric : contains
  AnalyticsReport *--> "1" LabMetric : contains
  AnalyticsReport *--> "1..*" StaffMetric : contains
  AnalyticsReport *--> "1" PendingBalanceMetric : contains
  SalesMetric --> Money : uses
  StaffMetric --> Money : uses
  PendingBalanceMetric --> Money : uses
  Money --> Currency : uses

  ' Infrastructure implementations
  AnalyticsReportRepository ..|> IAnalyticsReportRepository
  AnalyticsDataAggregator ..|> IAnalyticsDataAggregator
}

@enduml

